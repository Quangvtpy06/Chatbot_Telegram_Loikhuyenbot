# Các biến này được khai báo trong file dnse/.env, không đặt token thật tại đây.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_MODE=polling
TELEGRAM_USE_SYSTEM_PROXY=false
TELEGRAM_PROXY_URL=

# Chỉ cần khi TELEGRAM_MODE=webhook. URL là URL HTTPS đầy đủ gồm path.
TELEGRAM_WEBHOOK_URL=https://bot.example.com/telegram
TELEGRAM_WEBHOOK_LISTEN=127.0.0.1
TELEGRAM_WEBHOOK_PORT=8080
TELEGRAM_WEBHOOK_PATH=telegram
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Các giá trị dưới đây có thể bỏ qua để dùng mặc định.
TELEGRAM_ANALYTICS_DB=data/analytics/market_analytics.sqlite
TELEGRAM_QUALITY_REPORT=data/analytics/quality_report.json
TELEGRAM_BOT_DB=data/telegram_bot.sqlite
TELEGRAM_POLL_INTERVAL=1.0
TELEGRAM_COMMAND_COOLDOWN_SECONDS=1.5
TELEGRAM_WATCHLIST_LIMIT=50
TELEGRAM_AUTO_REFRESH=true
TELEGRAM_REALTIME_SYMBOLS=FPT,HPG,VCB
TELEGRAM_REALTIME_REFRESH_SECONDS=15
TELEGRAM_ANALYTICS_REFRESH_SECONDS=60
TELEGRAM_REALTIME_MAX_SYMBOLS=20
TELEGRAM_FUNDAMENTAL_AUTO_REFRESH=true
TELEGRAM_FUNDAMENTAL_REFRESH_HOURS=24
TELEGRAM_FUNDAMENTAL_PERIOD_LIMIT=5
TELEGRAM_FUNDAMENTAL_DELAY_SECONDS=1.1
TELEGRAM_PROACTIVE_NOTIFICATIONS=true
TELEGRAM_OUTBOX_BATCH_SIZE=50
PORTFOLIO_INITIAL_NAV=1000000000
RISK_MAX_DAILY_LOSS_PCT=0.03
RISK_MAX_DRAWDOWN_PCT=0.10
RISK_MIN_AVERAGE_TRADING_VALUE_VND=5000000000
RISK_MAX_ORDER_AVERAGE_VOLUME_PCT=0.10
RISK_BOARD_LOT_SIZE=100
TELEGRAM_DATA_DIR=data
TELEGRAM_ANALYTICS_OUTPUT_DIR=data/analytics
