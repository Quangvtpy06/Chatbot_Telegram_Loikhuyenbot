# =============================================================================
# FINSHIELD - CẤU HÌNH BIẾN MÔI TRƯỜNG (.env)
# =============================================================================
# Sao chép file này thành .env và điền thông tin của bạn:
#   cp .env.example .env   (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)

# -----------------------------------------------------------------------------
# 1. CẤU HÌNH DNSE OPENAPI (Dữ liệu thị trường, Giá realtime, Khối ngoại)
# -----------------------------------------------------------------------------
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_API_KEY=your_dnse_api_key_here
DNSE_API_SECRET=your_dnse_api_secret_here
DNSE_TIMEOUT=20
DNSE_MAX_RETRIES=3
DNSE_RETRY_SLEEP=1.5
DNSE_USE_SYSTEM_PROXY=false

# -----------------------------------------------------------------------------
# 2. CẤU HÌNH TELEGRAM BOT (FinShield Bot)
# -----------------------------------------------------------------------------
# Lấy token từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Danh sách Chat ID được phép dùng bot, phân tách bằng dấu phẩy (Ví dụ: 123456789,987654321)
# Để trống trong giai đoạn thử nghiệm để bất kỳ chat nào cũng có thể gửi lệnh
TELEGRAM_ALLOWED_CHAT_IDS=

# Chế độ chạy: polling (mặc định khi dev) hoặc webhook (khi deploy VPS/production)
TELEGRAM_MODE=polling

# Cấu hình Webhook (Chỉ dùng khi TELEGRAM_MODE=webhook)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram
TELEGRAM_WEBHOOK_LISTEN=127.0.0.1
TELEGRAM_WEBHOOK_PORT=8080
TELEGRAM_WEBHOOK_PATH=telegram
TELEGRAM_WEBHOOK_SECRET_TOKEN=your_random_secret_token_here

# Cấu hình Proxy mạng (Nếu môi trường mạng yêu cầu)
TELEGRAM_USE_SYSTEM_PROXY=false
TELEGRAM_PROXY_URL=

# -----------------------------------------------------------------------------
# 3. TIẾN TRÌNH NỀN & TỰ ĐỘNG CẬP NHẬT (Background Auto-Refresh)
# -----------------------------------------------------------------------------
# Tự động cập nhật giá realtime và chạy analytics định kỳ trong phiên
TELEGRAM_AUTO_REFRESH=true
TELEGRAM_REALTIME_SYMBOLS=FPT,HPG,VCB,MBB,TCB,SSI,VND
TELEGRAM_REALTIME_REFRESH_SECONDS=15
TELEGRAM_ANALYTICS_REFRESH_SECONDS=60
TELEGRAM_REALTIME_MAX_SYMBOLS=20

# Tự động quét và cập nhật BCTC ngoài giờ giao dịch
TELEGRAM_FUNDAMENTAL_AUTO_REFRESH=true
TELEGRAM_FUNDAMENTAL_REFRESH_HOURS=24
TELEGRAM_FUNDAMENTAL_PERIOD_LIMIT=5
TELEGRAM_FUNDAMENTAL_DELAY_SECONDS=1.1

# Tự động quét và gửi cảnh báo chủ động (Proactive Signals) cho Watchlist
TELEGRAM_PROACTIVE_NOTIFICATIONS=true
TELEGRAM_OUTBOX_BATCH_SIZE=50
TELEGRAM_POLL_INTERVAL=1.0
TELEGRAM_COMMAND_COOLDOWN_SECONDS=1.5
TELEGRAM_WATCHLIST_LIMIT=50

# -----------------------------------------------------------------------------
# 4. QUẢN TRỊ RỦI RO & DANH MỤC MÔ PHỎNG (Risk Gate & Portfolio)
# -----------------------------------------------------------------------------
PORTFOLIO_INITIAL_NAV=1000000000
RISK_MAX_DAILY_LOSS_PCT=0.03
RISK_MAX_DRAWDOWN_PCT=0.10
RISK_MIN_AVERAGE_TRADING_VALUE_VND=5000000000
RISK_MAX_ORDER_AVERAGE_VOLUME_PCT=0.10
RISK_BOARD_LOT_SIZE=100

# -----------------------------------------------------------------------------
# 5. ĐƯỜNG DẪN DỮ LIỆU & CƠ SỞ DỮ LIỆU (Database & Storage Paths)
# -----------------------------------------------------------------------------
TELEGRAM_DATA_DIR=data
TELEGRAM_ANALYTICS_OUTPUT_DIR=data/analytics
TELEGRAM_ANALYTICS_DB=data/analytics/market_analytics.sqlite
TELEGRAM_QUALITY_REPORT=data/analytics/quality_report.json
TELEGRAM_BOT_DB=data/telegram_bot.sqlite
